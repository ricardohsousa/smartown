{
  "name": "smartown",
  "version": "0.1.0",
  "description": "SmarTown: registro e acompanhamento de problemas urbanos (Operação Deploy, UTFPR).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml \"tests/**/*.test.js\"",
    "build": "node scripts/build.mjs",
    "start": "npm run build && npx --yes serve dist",
    "verify": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
